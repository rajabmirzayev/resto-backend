# ============================================================
# Tabler environment template
# Copy to .env and fill in your values. Never commit .env.
# ============================================================

# ---------- Postgres ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tabler
POSTGRES_PORT=5432
POSTGRES_URL=jdbc:postgresql://localhost:5432/tabler

# ---------- CORS (frontend origins) ----------
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:3000,http://localhost:5173

# ---------- Keycloak ----------
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://db:5432/tabler
KC_DB_USERNAME=postgres
KC_DB_PASSWORD=change-me
KC_HEALTH_ENABLED=true

# ---------- Keycloak bootstrap (platform user) ----------
PLATFORM_BOOTSTRAP_EMAIL=platform@codlab.az
PLATFORM_BOOTSTRAP_PASSWORD=change-me
PLATFORM_BOOTSTRAP_ORG_ID=a55faced-dead-4bed-babe-feeddeadbeef

# ---------- pgAdmin ----------
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me

# ---------- auth-gateway ----------
AUTH_KEYCLOAK_URL=http://localhost:8080
AUTH_KEYCLOAK_REALM=tabler
AUTH_KEYCLOAK_CLIENT_ID=tabler-auth
AUTH_KEYCLOAK_CLIENT_SECRET=change-me
AUTH_KEYCLOAK_CONNECT_TIMEOUT=5000
AUTH_KEYCLOAK_READ_TIMEOUT=10000
AUTH_SERVER_PORT=8002

# ---------- cloud-gateway ----------
GW_REDIS_HOST=localhost
GW_REDIS_PORT=6379
GW_KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/tabler
GW_KEYCLOAK_AUDIENCE=
GW_KEYCLOAK_CLIENT_ID=tabler-gateway
GW_SERVER_PORT=8001
GW_AUTH_MANAGEMENT_URL=http://localhost:8002
GW_ORGANIZATION_URL=http://localhost:8102
GW_DASHBOARD_URL=http://localhost:8112
GW_REPORT_URL=http://localhost:8113
GW_CUSTOMER_URL=http://localhost:8110
GW_WAITER_URL=http://localhost:8109
GW_KITCHEN_URL=http://localhost:8108
GW_ORDER_URL=http://localhost:8107
GW_SETTING_URL=http://localhost:8111
GW_ROLE_URL=http://localhost:8104
GW_USER_URL=http://localhost:8103
GW_MENU_URL=http://localhost:8105
GW_TABLE_URL=http://localhost:8106

# ---------- Shared ----------
JPA_DDL_AUTO=validate

# ---------- Inter-service URLs ----------
USER_SERVICE_URL=http://localhost:8103
ROLE_SERVICE_URL=http://localhost:8104
ORGANIZATION_SERVICE_URL=http://localhost:8102
MENU_SERVICE_URL=http://localhost:8105
TABLE_SERVICE_URL=http://localhost:8106
ORDER_SERVICE_URL=http://localhost:8107
SETTING_SERVICE_URL=http://localhost:8111

# ---------- user-service ----------
USER_DB_URL=jdbc:postgresql://localhost:5432/tabler?currentSchema=tabler_user
USER_DB_USERNAME=postgres
USER_DB_PASSWORD=change-me
USER_SERVER_PORT=8103

# ---------- role-service ----------
ROLE_DB_URL=jdbc:postgresql://localhost:5432/tabler?currentSchema=tabler_role
ROLE_DB_USERNAME=postgres
ROLE_DB_PASSWORD=change-me
ROLE_SERVER_PORT=8104

# ---------- organization-service ----------
ORG_DB_URL=jdbc:postgresql://localhost:5432/tabler?currentSchema=tabler_organization
ORG_DB_USERNAME=postgres
ORG_DB_PASSWORD=change-me
ORG_SERVER_PORT=8102

# ---------- menu-service ----------
MENU_DB_URL=jdbc:postgresql://localhost:5432/tabler?currentSchema=tabler_menu
MENU_DB_USERNAME=postgres
MENU_DB_PASSWORD=change-me
MENU_SERVER_PORT=8105
MENU_STORAGE_DIR=./data/menu-images
MENU_PUBLIC_BASE_URL=http://localhost:8001

# ---------- table-service ----------
TABLE_DB_URL=jdbc:postgresql://localhost:5432/tabler?currentSchema=tabler_table
TABLE_DB_USERNAME=postgres
TABLE_DB_PASSWORD=change-me
TABLE_SERVER_PORT=8106

# ---------- order-service ----------
ORDER_DB_URL=jdbc:postgresql://localhost:5432/tabler?currentSchema=tabler_order
ORDER_DB_USERNAME=postgres
ORDER_DB_PASSWORD=change-me
ORDER_SERVER_PORT=8107

# ---------- kitchen-service ----------
KITCHEN_SERVER_PORT=8108

# ---------- waiter-service ----------
WAITER_SERVER_PORT=8109

# ---------- customer-service ----------
CUSTOMER_SERVER_PORT=8110

# ---------- setting-service ----------
SETTING_DB_URL=jdbc:postgresql://localhost:5432/tabler?currentSchema=tabler_setting
SETTING_DB_USERNAME=postgres
SETTING_DB_PASSWORD=change-me
SETTING_SERVER_PORT=8111

# ---------- dashboard-service ----------
DASHBOARD_SERVER_PORT=8112

# ---------- report-service ----------
REPORT_SERVER_PORT=8113
